<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only: lets us simulate an incoming bank SMS via adb without a
             real SMS or real payment. Never merged into release builds. -->
        <receiver
            android:name="com.letstrack.app.sms.DebugSmsSimulatorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.letstrack.app.DEBUG_SIMULATE_SMS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
